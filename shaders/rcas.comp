#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rgba8) uniform image2D inputImage;
layout(set = 0, binding = 1, rgba8) uniform image2D outputImage;
layout(push_constant) uniform Constants { uvec4 con; } pc;

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_RCAS_F 1
#include "ffx_fsr1.h"

AF4 FsrRcasLoadF(ASU2 p) {
    ivec2 size = imageSize(inputImage);
    return imageLoad(inputImage, clamp(ivec2(p), ivec2(0), size - ivec2(1)));
}
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}

void main() {
    uvec2 ip = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(ip, uvec2(imageSize(outputImage))))) {
        return;
    }
    AF1 r;
    AF1 g;
    AF1 b;
    FsrRcasF(r, g, b, ip, pc.con);
    imageStore(outputImage, ivec2(ip), vec4(r, g, b, 1.0));
}
