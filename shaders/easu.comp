#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) uniform sampler2D inputTexture;
layout(set = 0, binding = 1, rgba8) uniform image2D outputImage;
layout(push_constant) uniform Constants {
    uvec4 con0;
    uvec4 con1;
    uvec4 con2;
    uvec4 con3;
} pc;

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_EASU_F 1
#include "ffx_fsr1.h"

AF4 FsrEasuRF(AF2 p) { return textureGather(inputTexture, p, 0); }
AF4 FsrEasuGF(AF2 p) { return textureGather(inputTexture, p, 1); }
AF4 FsrEasuBF(AF2 p) { return textureGather(inputTexture, p, 2); }

void main() {
    uvec2 ip = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(ip, uvec2(imageSize(outputImage))))) {
        return;
    }
    AF3 color;
    FsrEasuF(color, ip, pc.con0, pc.con1, pc.con2, pc.con3);
    imageStore(outputImage, ivec2(ip), vec4(color, 1.0));
}
